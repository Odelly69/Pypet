<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:name=".PypetApplication"
        android:theme="@style/AppTheme"
        android:label="Pypet Python Academy"
        android:icon="@drawable/ic_pypet"
        android:roundIcon="@drawable/ic_pypet"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:installLocation="auto">
        <meta-data android:name="com.google.android.gms.ads.APPLICATION_ID" android:value="ca-app-pub-3352973554477677~1000449378" />
        <activity android:name=".MainActivity" android:exported="true" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".PypetReminderReceiver" android:exported="false" />
    </application>
</manifest>
